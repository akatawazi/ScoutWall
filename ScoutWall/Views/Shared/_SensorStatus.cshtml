@model List<SensorStatus>
@if (Model.Count == 0)
{
    <div class="alert alert-warning mb-4" role="status">
        <strong>No sensor has reported yet.</strong> Start ScoutWall.Sensor (as administrator for live capture, firewall actions and per-program tracking).
        Data appears here within a few seconds of the sensor starting.
    </div>
}
@foreach (var sensorStatus in Model)
{
    <div class="card mb-4">
        <div class="card-body py-2 d-flex flex-wrap align-items-center gap-3 small">
            @if (sensorStatus.IsOnline)
            {
                <span class="sw-status-online fw-semibold">● Sensor online</span>
            }
            else
            {
                <span class="sw-status-offline fw-semibold">■ Sensor offline</span>
            }
            <span><strong>@sensorStatus.SensorName</strong> &middot; @sensorStatus.CaptureMode capture</span>
            <span>Last heartbeat @Display.Time(sensorStatus.LastHeartbeatAt)</span>
            <span>@Display.BitRate(sensorStatus.BitsPerSecond) &middot; @sensorStatus.PacketsPerSecond.ToString("0") packets/s</span>
            <span>Dropped @Display.Number(sensorStatus.PacketsDropped)</span>
            <span>User: @(sensorStatus.IsUserIdle switch { true => "away (idle)", false => "active", _ => "unknown" })</span>
            <span>Response mode: @sensorStatus.ActiveResponseMode</span>
            @if (!string.IsNullOrEmpty(sensorStatus.LastError))
            {
                <span class="text-danger w-100">Last problem: @sensorStatus.LastError</span>
            }
        </div>
    </div>
}
