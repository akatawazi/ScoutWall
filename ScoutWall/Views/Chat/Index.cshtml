@model ChatPage
@{
    ViewData["Title"] = "Ask ScoutWall";
}
<div class="sw-home mx-auto">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 m-0">Ask ScoutWall</h1>
        @if (Model.Messages.Count > 0)
        {
            <form method="post" asp-action="Clear"><button type="submit" class="btn btn-sm btn-link text-body-secondary">Start over</button></form>
        }
    </div>

    @if (!Model.Assistant.IsReady)
    {
        <div class="alert alert-warning">No assistant is set up yet. <a asp-controller="Setup" asp-action="Assistant">Choose one</a> to ask questions and make changes by chatting.</div>
    }
    else if (!Model.CanProposeChanges)
    {
        <div class="alert alert-info small">With @Model.Assistant.ProviderDisplayName the assistant can answer questions. To make changes by chatting, choose Claude under Settings; otherwise it will point you to the right setting.</div>
    }

    <div class="sw-chat mb-3">
        @if (Model.Messages.Count == 0)
        {
            <div class="text-body-secondary mb-3">Ask anything about what your computer is doing on the internet, or tell ScoutWall what you'd like changed. For example:</div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var suggestion in ChatPage.Suggestions)
                {
                    <form method="post" asp-action="Send">
                        <input type="hidden" name="message" value="@suggestion" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary" @(Model.Assistant.IsReady ? "" : "disabled")>@suggestion</button>
                    </form>
                }
            </div>
        }
        @for (var index = 0; index < Model.Messages.Count; index++)
        {
            var message = Model.Messages[index];
            var nextMessage = index + 1 < Model.Messages.Count ? Model.Messages[index + 1] : null;
            <div class="sw-chat-message @(message.FromUser ? "sw-chat-user" : "sw-chat-assistant")">
                <div class="sw-chat-bubble">@(message.FromUser ? new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(message.Text)) : Display.ChatText(message.Text))</div>
            </div>
            @if (!message.FromUser)
            {
                foreach (var change in Model.ChangesAfter(message, nextMessage))
                {
                    <div class="card sw-change-card mb-3">
                        <div class="card-body">
                            <div class="small text-body-secondary mb-1">Proposed change</div>
                            <div class="fw-semibold">@change.Summary</div>
                            @if (change.Consequence != null)
                            {
                                <div class="small mt-1">@change.Consequence</div>
                            }
                            @if (change.BasedOnNetworkData)
                            {
                                <div class="small text-warning-emphasis mt-1">⚠ Suggested after reading network data. Make sure this is what you want.</div>
                            }
                            @if (change.IsOpen)
                            {
                                <div class="d-flex gap-2 mt-2">
                                    <form method="post" asp-action="Confirm" asp-route-id="@change.Id"><button type="submit" class="btn btn-sm btn-primary">Confirm</button></form>
                                    <form method="post" asp-action="Reject" asp-route-id="@change.Id"><button type="submit" class="btn btn-sm btn-outline-secondary">No thanks</button></form>
                                </div>
                            }
                            else
                            {
                                <div class="small mt-2">
                                    @(change.Status switch
                                    {
                                        PendingChangeStatus.Applied => "✓ Done",
                                        PendingChangeStatus.Rejected => "Not applied",
                                        PendingChangeStatus.Failed => $"Couldn't apply: {change.Error}",
                                        _ => "Expired. Ask again if you still want this."
                                    })
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
    </div>

    <form method="post" asp-action="Send" class="d-flex gap-2" data-busy-text="Thinking…">
        <input name="message" class="form-control form-control-lg" maxlength="2000" autofocus autocomplete="off"
               placeholder="Ask a question or say what you'd like changed" @(Model.Assistant.IsReady ? "" : "disabled") />
        <button type="submit" class="btn btn-primary" @(Model.Assistant.IsReady ? "" : "disabled")>Send</button>
    </form>
</div>
