@model VerdictReport
@{
    ViewData["Title"] = "Flow analysis";
    var judgedVerdicts = new[] { Verdict.Ok, Verdict.Suspicious, Verdict.Problematic, Verdict.Abstain };
}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 m-0">Flow analysis</h1>
        <div class="text-body-secondary small">
            Every recent flow to the internet is judged by the explainable ScoreCard@(Model.Settings.ZevEnabled ? $" and by zev ({Model.Settings.ZevMode} mode)" : "").
            <a asp-controller="Settings" asp-action="Index" asp-route-tab="analysis">Configure</a>
        </div>
    </div>
    <form method="get" class="d-flex gap-2">
        <select name="provider" class="form-select form-select-sm" aria-label="Provider">
            <option value="">All providers</option>
            <option value="@FlowVerdict.ScoreCardProvider" selected="@(Model.Provider == FlowVerdict.ScoreCardProvider)">ScoreCard</option>
            <option value="@FlowVerdict.ZevProvider" selected="@(Model.Provider == FlowVerdict.ZevProvider)">zev</option>
        </select>
        <select name="verdict" class="form-select form-select-sm" aria-label="Verdict">
            <option value="">Any verdict</option>
            @foreach (var verdict in judgedVerdicts)
            {
                <option value="@verdict" selected="@(Model.Verdict == verdict)">@verdict</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
    </form>
</div>

<div class="card mb-4">
    <div class="card-header">Agreement between the ScoreCard and zev (last 7 days)</div>
    <div class="card-body">
        @if (Model.AgreementTotal == 0)
        {
            <p class="small text-body-secondary mb-0">
                No flows have been judged by both yet. Enable zev in shadow mode to start measuring it against the ScoreCard
                before letting it raise alerts. zev is a general text decision engine, not a network model, so treat its verdicts as unproven until this table says otherwise.
            </p>
        }
        else
        {
            <p class="small mb-2">
                Agreed on @Model.AgreementMatches of @Model.AgreementTotal flows (@Display.Percent((double)Model.AgreementMatches / Model.AgreementTotal)).
                Rows are the ScoreCard's verdict; columns are zev's.
            </p>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0 text-end" style="max-width: 36rem">
                    <thead>
                        <tr><th class="text-start">ScoreCard \ zev</th>@foreach (var verdict in judgedVerdicts) { <th>@verdict</th> }</tr>
                    </thead>
                    <tbody>
                        @foreach (var scoreCardVerdict in judgedVerdicts.Take(3))
                        {
                            <tr>
                                <th class="text-start">@scoreCardVerdict</th>
                                @foreach (var zevVerdict in judgedVerdicts)
                                {
                                    <td class="@(scoreCardVerdict == zevVerdict ? "fw-semibold" : "")">@Model.CountFor(scoreCardVerdict, zevVerdict)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">Recent verdicts</div>
    @if (Model.Verdicts.Count == 0)
    {
        <p class="text-body-secondary small m-0 p-3">No verdicts yet. The sensor judges flows every @Model.Settings.EvaluationIntervalSeconds seconds once traffic is flowing.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr><th>Time</th><th>Provider</th><th>Verdict</th><th>Flow</th><th>Program</th><th>Why</th></tr>
                </thead>
                <tbody>
                    @foreach (var flowVerdict in Model.Verdicts)
                    {
                        <tr>
                            <td class="small text-nowrap">@Display.Time(flowVerdict.EvaluatedAt)</td>
                            <td class="small">@flowVerdict.Provider@(flowVerdict.IsShadow ? " (shadow)" : "")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@flowVerdict.Id"><span class="badge @flowVerdict.VerdictBadgeClass">@flowVerdict.Verdict</span></a>
                                @if (flowVerdict.Score.HasValue)
                                {
                                    <span class="small text-body-secondary">@flowVerdict.Score pts</span>
                                }
                                else
                                {
                                    <span class="small text-body-secondary">@flowVerdict.Confidence.ToString("0.00")</span>
                                }
                            </td>
                            <td class="small">
                                @Display.Direction(flowVerdict.Direction) @flowVerdict.Protocol/@flowVerdict.ServicePort
                                <a asp-controller="Addresses" asp-action="Details" asp-route-id="@flowVerdict.RemoteIp" class="sw-mono">@flowVerdict.RemoteIp</a>
                                @if (flowVerdict.Hostname != null)
                                {
                                    <div class="text-body-secondary sw-truncate">@flowVerdict.Hostname</div>
                                }
                            </td>
                            <td class="small sw-truncate" title="@flowVerdict.ProcessPath">@(flowVerdict.ProcessPath == null ? "-" : System.IO.Path.GetFileName(flowVerdict.ProcessPath))</td>
                            <td class="small sw-truncate" title="@flowVerdict.Reasons">@Display.Truncate(flowVerdict.Reasons, 90)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
