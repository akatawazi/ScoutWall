@model SettingsOverview
@{
    ViewData["Title"] = "What to watch";
    var sensor = Model.Sensors.FirstOrDefault();
    var selected = Model.Capture.InterfaceNames;
    var visibleInterfaces = Model.Interfaces.Where(item => !item.IsLoopback).OrderByDescending(item => item.IsRecommended).ToList();
}
<div class="sw-setup mx-auto">
    <partial name="_SetupProgress" model="1" />
    <h1 class="h3">Which connections should ScoutWall watch?</h1>
    <p class="text-body-secondary">We've ticked the ones this computer uses to reach the internet. Most people can just press Continue.</p>

    @if (sensor == null || !sensor.IsOnline)
    {
        <div class="alert alert-warning">
            <strong>The ScoutWall monitor isn't running yet.</strong>
            Run <code>scoutwall install</code> as administrator (it installs the monitor as a service), then reload this page.
            You can continue now and change this later.
        </div>
    }
    else if (sensor.LastError != null && sensor.LastError.Contains("Npcap", StringComparison.OrdinalIgnoreCase))
    {
        <div class="alert alert-warning"><strong>One more thing to install:</strong> ScoutWall needs the free Npcap driver from <a href="https://npcap.com" rel="noreferrer">npcap.com</a> to see network traffic.</div>
    }

    <form method="post" asp-action="Watch" asp-route-fromSettings="@(Context.Request.Query["fromSettings"].ToString() is { Length: > 0 } fromSettings ? fromSettings : null)">
        <div class="row g-3 mb-4">
            @foreach (var captureInterface in visibleInterfaces)
            {
                var isChecked = selected.Count == 0 ? captureInterface.IsRecommended : selected.Contains(captureInterface.Name);
                var checkboxId = "watch-" + Math.Abs(captureInterface.Name.GetHashCode());
                <div class="col-md-6">
                    <label class="card sw-choice h-100" for="@checkboxId">
                        <div class="card-body d-flex gap-3">
                            <input class="form-check-input mt-1" type="checkbox" id="@checkboxId" name="interfaceNames" value="@captureInterface.Name" checked="@isChecked" />
                            <div>
                                <div class="fw-semibold">@captureInterface.DisplayName</div>
                                <div class="small text-body-secondary">@captureInterface.KindDescription@(captureInterface.IsRecommended ? " · recommended" : "")</div>
                            </div>
                        </div>
                    </label>
                </div>
            }
            @if (visibleInterfaces.Count == 0)
            {
                <p class="text-body-secondary">No connections reported yet. ScoutWall will watch your internet connections automatically.</p>
            }
        </div>
        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-lg">Continue</button>
        </div>
    </form>
</div>
